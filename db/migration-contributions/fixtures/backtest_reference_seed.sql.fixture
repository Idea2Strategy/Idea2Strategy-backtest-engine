-- B's own published datasetManifestId, from the same
-- strategy-bot/v1/official-backtest-request.valid.json as B's bot id above.
-- Card D91 requires B's released message to be accepted **verbatim**, and
-- `backtest.run_input_pins.dataset_manifest_id` is a foreign key into
-- `market_data.dataset_manifests` -- the same reference the applied baseline already
-- imposes on `backtest.input_datasets.dataset_manifest_id` -- so B's manifest has to
-- exist for the acceptance transaction to insert anything at all. Re-addressing the
-- message to the 2024-Q1 fixture manifest instead would test a message B does not
-- publish.
--
-- The window is B's release quarter (2026-Q3), which is what `b_dataset_manifest()`
-- declares in memory. `dataset_hash` here is a distinct placeholder: the column is
-- globally UNIQUE, and the value the pins row actually stores is the runtime hash of
-- the pinned Parquet bytes, which this row neither constrains nor is compared with.
INSERT INTO market_data.dataset_manifests (
  id, feed_id, instrument_id, data_layer, resolution, revision_number, status,
  period_start, period_end, schema_version, dataset_hash, created_at, available_at)
VALUES ('00000000-0000-4000-8000-000000000203', '00000000-0000-4000-8000-000000000092',
        '00000000-0000-4000-8000-000000000093', 'VALIDATED', 'PT1M', 1, 'AVAILABLE',
        '2026-07-01T04:00:00+00', '2026-10-01T04:00:00+00', '1.0.0',
        'ds00000000000000000000000000000000000000000000000000000000000203',
        '2026-01-01T00:00:00+00', '2026-01-01T00:00:00+00');

