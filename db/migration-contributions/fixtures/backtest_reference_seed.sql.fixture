        '2026-01-01T00:00:00+00', '2026-01-01T00:00:00+00', 0, '2026-01-01T00:00:00+00');

-- B's own published bot id, from
-- backend/modules/backend-messaging/.../strategy-bot/v1/official-backtest-request.valid.json.
-- Card D91 requires that B's released message be accepted **verbatim**, and
-- backtest.runs.bot_id is a foreign key into bot.bots, so B's bot has to exist for
-- the real-infrastructure test to insert anything at all. Re-addressing the message
-- to the fixture bot instead would test a message B does not publish.
INSERT INTO bot.bots (
  id, owner_account_id, mode, name, lifecycle_status, lifecycle_changed_at,
  created_at, execution_eligible_from, edit_sequence, updated_at)
