-- Integration-test reference rows for the cross-domain foreign keys that
-- `backtest.*` depends on. Test-only fixture data: never a seed, never a migration.
--
-- Fixed UUIDs so integration assertions can be literal.
--   account   00000000-0000-4000-8000-0000000000a1
--   bot       00000000-0000-4000-8000-0000000000b1
--   b's bot   00000000-0000-4000-8000-000000000201  (B's published fixture, card D91)
--   fee       00000000-0000-4000-8000-0000000000f1
--   buffer    00000000-0000-4000-8000-0000000000f2
--   dataset   00000000-0000-4000-8000-0000000000d1
--   b's data  00000000-0000-4000-8000-000000000203  (B's published fixture, card D91)
--   feature   00000000-0000-4000-8000-0000000000e1
--   object    00000000-0000-4000-8000-0000000000c1
--   object2   00000000-0000-4000-8000-0000000000c2

INSERT INTO identity.accounts (id, lifecycle_status, status_changed_at, created_at)
VALUES ('00000000-0000-4000-8000-0000000000a1', 'ACTIVE',
        '2026-01-01T00:00:00+00', '2026-01-01T00:00:00+00');

