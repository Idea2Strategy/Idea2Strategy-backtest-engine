{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.idea2strategy.io/strategy-bot/v1/message-metadata.schema.json",
  "title": "strategy-bot.v1 message metadata envelope",
  "description": "Consumer-side mirror of com.idea2strategy.backend.messaging.strategybot.v1.StrategyBotContractFixtures.MessageMetadata. B (backend) owns the producing contract; this file exists only so D can reject malformed input, and must never redefine it.",
  "type": "object",
  "required": [
    "contractVersion",
    "messageType",
    "messageId",
    "occurredAt",
    "correlationId",
    "idempotencyKey"
  ],
  "properties": {
    "contractVersion": {"const": "strategy-bot.v1"},
    "messageType": {"$ref": "https://contracts.idea2strategy.io/common/v1/primitives.schema.json#/$defs/nonEmptyString"},
    "messageId": {"$ref": "https://contracts.idea2strategy.io/common/v1/primitives.schema.json#/$defs/uuid"},
    "occurredAt": {"$ref": "https://contracts.idea2strategy.io/common/v1/primitives.schema.json#/$defs/utcTimestamp"},
    "correlationId": {"$ref": "https://contracts.idea2strategy.io/common/v1/primitives.schema.json#/$defs/uuid"},
    "idempotencyKey": {"$ref": "https://contracts.idea2strategy.io/common/v1/primitives.schema.json#/$defs/sha256Prefixed"}
  }
}
