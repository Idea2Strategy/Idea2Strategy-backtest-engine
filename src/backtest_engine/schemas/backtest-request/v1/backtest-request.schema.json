{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.idea2strategy.io/backtest-request/v1/backtest-request.schema.json",
  "title": "Backtest request v1 provider envelope",
  "oneOf": [
    { "$ref": "#/$defs/custom" },
    { "$ref": "#/$defs/competitionPeriod" }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "uuid": { "type": "string", "format": "uuid" },
    "positiveDecimal": { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)?$" },
    "metadata": {
      "type": "object",
      "required": ["contractVersion", "messageType", "messageId", "occurredAt", "correlationId", "idempotencyKey"],
      "properties": {
        "contractVersion": { "const": "backtest-request.v1" },
        "messageType": { "enum": ["CUSTOM_BACKTEST_REQUESTED", "COMPETITION_BACKTEST_REQUESTED"] },
        "messageId": { "$ref": "#/$defs/uuid" },
        "occurredAt": { "type": "string", "format": "date-time" },
        "correlationId": { "$ref": "#/$defs/uuid" },
        "idempotencyKey": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "common": {
      "type": "object",
      "required": ["metadata", "requestReason", "requestHash", "runId", "lane", "aggregateSequence", "botId", "expectedSnapshotHash", "compiledPlanChecksum", "assumptionsVersion", "executionPolicyVersion"],
      "properties": {
        "metadata": { "$ref": "#/$defs/metadata" },
        "requestReason": { "type": "string" },
        "requestHash": { "$ref": "#/$defs/sha256" },
        "runId": { "$ref": "#/$defs/uuid" },
        "lane": { "enum": ["CUSTOM", "COMPETITION"] },
        "aggregateSequence": { "const": 1 },
        "botId": { "$ref": "#/$defs/uuid" },
        "expectedSnapshotHash": { "$ref": "#/$defs/sha256" },
        "compiledPlanChecksum": { "$ref": "#/$defs/sha256" },
        "assumptionsVersion": { "type": "string", "minLength": 1 },
        "executionPolicyVersion": { "type": "string", "minLength": 1 }
      }
    },
    "custom": {
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object",
          "required": ["metadata", "requestReason", "requestHash", "requestingAccountId", "botId", "runId", "lane", "aggregateSequence", "expectedSnapshotHash", "compiledPlanChecksum", "datasetManifestId", "expectedDatasetHash", "periodStart", "periodEnd", "instrumentCatalogVersion", "initialCashAmount", "assumptionsVersion", "executionPolicyVersion"],
          "properties": {
            "metadata": {
              "allOf": [
                { "$ref": "#/$defs/metadata" },
                { "type": "object", "properties": { "messageType": { "const": "CUSTOM_BACKTEST_REQUESTED" } } }
              ]
            },
            "requestReason": { "const": "USER_PERIOD" },
            "requestHash": { "$ref": "#/$defs/sha256" },
            "requestingAccountId": { "$ref": "#/$defs/uuid" },
            "botId": { "$ref": "#/$defs/uuid" },
            "runId": { "$ref": "#/$defs/uuid" },
            "lane": { "const": "CUSTOM" },
            "aggregateSequence": { "const": 1 },
            "expectedSnapshotHash": { "$ref": "#/$defs/sha256" },
            "compiledPlanChecksum": { "$ref": "#/$defs/sha256" },
            "datasetManifestId": { "$ref": "#/$defs/uuid" },
            "expectedDatasetHash": { "$ref": "#/$defs/sha256" },
            "periodStart": { "type": "string", "format": "date" },
            "periodEnd": { "type": "string", "format": "date" },
            "instrumentCatalogVersion": { "type": "string", "minLength": 1 },
            "initialCashAmount": { "$ref": "#/$defs/positiveDecimal" },
            "assumptionsVersion": { "type": "string", "minLength": 1 },
            "executionPolicyVersion": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      ]
    },
    "competitionDataset": {
      "type": "object",
      "required": ["datasetManifestId", "purposeCode", "expectedDatasetHash"],
      "properties": {
        "datasetManifestId": { "$ref": "#/$defs/uuid" },
        "purposeCode": { "type": "string", "minLength": 1 },
        "expectedDatasetHash": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "competitionFeature": {
      "type": "object",
      "required": ["featureMaterializationId", "lockedResultHash"],
      "properties": {
        "featureMaterializationId": { "$ref": "#/$defs/uuid" },
        "lockedResultHash": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "competitionPeriodItem": {
      "type": "object",
      "required": ["evaluationPeriodId", "periodSequence", "evaluationStart", "evaluationEnd", "importanceWeight", "inputSetHash", "datasets", "featureMaterializations"],
      "properties": {
        "evaluationPeriodId": { "$ref": "#/$defs/uuid" },
        "periodSequence": { "type": "integer", "minimum": 1 },
        "evaluationStart": { "type": "string", "format": "date" },
        "evaluationEnd": { "type": "string", "format": "date" },
        "importanceWeight": { "$ref": "#/$defs/positiveDecimal" },
        "inputSetHash": { "$ref": "#/$defs/sha256" },
        "datasets": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/competitionDataset" } },
        "featureMaterializations": { "type": "array", "items": { "$ref": "#/$defs/competitionFeature" } }
      },
      "additionalProperties": false
    },
    "competitionPeriod": {
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object",
          "required": ["metadata", "requestReason", "requestHash", "runId", "lane", "aggregateSequence", "roomId", "participationId", "botId", "planVersion", "planHash", "expectedSnapshotHash", "compiledPlanChecksum", "assumptionsVersion", "executionPolicyVersion", "scoringTemplateVersionId", "roomRulesHash", "initialCashAmount", "currencyCode", "periods"],
          "properties": {
            "metadata": {
              "allOf": [
                { "$ref": "#/$defs/metadata" },
                { "type": "object", "properties": { "messageType": { "const": "COMPETITION_BACKTEST_REQUESTED" } } }
              ]
            },
            "requestReason": { "const": "COMPETITION_EVALUATION" },
            "requestHash": { "$ref": "#/$defs/sha256" },
            "runId": { "$ref": "#/$defs/uuid" },
            "lane": { "const": "COMPETITION" },
            "aggregateSequence": { "const": 1 },
            "roomId": { "$ref": "#/$defs/uuid" },
            "participationId": { "$ref": "#/$defs/uuid" },
            "botId": { "$ref": "#/$defs/uuid" },
            "planVersion": { "type": "string", "minLength": 1 },
            "planHash": { "$ref": "#/$defs/sha256" },
            "expectedSnapshotHash": { "$ref": "#/$defs/sha256" },
            "compiledPlanChecksum": { "$ref": "#/$defs/sha256" },
            "assumptionsVersion": { "type": "string", "minLength": 1 },
            "executionPolicyVersion": { "type": "string", "minLength": 1 },
            "scoringTemplateVersionId": { "$ref": "#/$defs/uuid" },
            "roomRulesHash": { "$ref": "#/$defs/sha256" },
            "initialCashAmount": { "$ref": "#/$defs/positiveDecimal" },
            "currencyCode": { "const": "USD" },
            "periods": { "type": "array", "minItems": 1, "maxItems": 1, "items": { "$ref": "#/$defs/competitionPeriodItem" } }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
