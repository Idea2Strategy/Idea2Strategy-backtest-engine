{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.idea2strategy.io/backtest/v1/backtest-result.schema.json",
  "title": "backtest.v1 result event",
  "description": "Published by D (backtest-engine) for every backtest.run_status value in db/schema.dbml: QUEUED, RUNNING, COMPLETED, FAILED, CANCELLED, UNAVAILABLE. Card D93: source/eventType/livePerformanceEligible are constants that mark the event as a backtest result, matching exactly the input E's room-performance/v1 live-performance-input.backtest-rejected.json declares it refuses.",
  "type": "object",
  "required": [
    "metadata",
    "backtestRunId",
    "botId",
    "ownerAccountId",
    "expectedSnapshotHash",
    "inputBundleFingerprint",
    "executionPolicyVersion",
    "precisionRulesVersion",
    "status",
    "source",
    "eventType",
    "livePerformanceEligible"
  ],
  "properties": {
    "metadata": {"$ref": "https://contracts.idea2strategy.io/backtest/v1/message-metadata.schema.json"},
    "source": {
      "description": "D93: always BACKTEST. A live consumer must be able to refuse this event on its own content, not on the topic it arrived from.",
      "const": "BACKTEST"
    },
    "eventType": {
      "description": "D93: always BACKTEST_RESULT, the value E's live-performance-input.backtest-rejected.json rejects with BACKTEST_SOURCE_NOT_ALLOWED.",
      "const": "BACKTEST_RESULT"
    },
    "livePerformanceEligible": {
      "description": "D93: always false. Stated positively so an unrecognised source token can never be read as eligibility.",
      "const": false
    },
    "backtestRunId": {"$ref": "#/$defs/uuid"},
    "botId": {"$ref": "#/$defs/uuid"},
    "ownerAccountId": {"$ref": "#/$defs/uuid"},
    "expectedSnapshotHash": {"$ref": "#/$defs/sha256"},
    "inputBundleFingerprint": {"$ref": "#/$defs/sha256"},
    "executionPolicyVersion": {"$ref": "#/$defs/text"},
    "precisionRulesVersion": {"$ref": "#/$defs/text"},
    "status": {
      "enum": ["QUEUED", "RUNNING", "COMPLETED", "FAILED", "CANCELLED", "UNAVAILABLE"]
    },
    "queuedAt": {"$ref": "#/$defs/timestamp"},
    "startedAt": {"$ref": "#/$defs/timestamp"},
    "completedAt": {"$ref": "#/$defs/timestamp"},
    "failedAt": {"$ref": "#/$defs/timestamp"},
    "cancelledAt": {"$ref": "#/$defs/timestamp"},
    "decidedAt": {"$ref": "#/$defs/timestamp"},
    "attempt": {"type": "integer", "minimum": 1},
    "resultManifestId": {"$ref": "#/$defs/uuid"},
    "resultHash": {"$ref": "#/$defs/sha256"},
    "failureCode": {"$ref": "#/$defs/text"},
    "retryable": {"type": "boolean"},
    "reasonCode": {"$ref": "#/$defs/text"},
    "missingRequirements": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/text"}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "QUEUED"}}, "required": ["status"]},
      "then": {
        "required": ["queuedAt"],
        "properties": {
          "metadata": {"properties": {"messageType": {"const": "BACKTEST_QUEUED"}}}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "RUNNING"}}, "required": ["status"]},
      "then": {
        "required": ["startedAt", "attempt"],
        "properties": {
          "metadata": {"properties": {"messageType": {"const": "BACKTEST_RUNNING"}}}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "COMPLETED"}}, "required": ["status"]},
      "then": {
        "required": ["completedAt", "attempt", "resultManifestId", "resultHash"],
        "properties": {
          "metadata": {"properties": {"messageType": {"const": "BACKTEST_COMPLETED"}}}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "FAILED"}}, "required": ["status"]},
      "then": {
        "required": ["failedAt", "attempt", "failureCode", "retryable"],
        "properties": {
          "metadata": {"properties": {"messageType": {"const": "BACKTEST_FAILED"}}}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "UNAVAILABLE"}}, "required": ["status"]},
      "then": {
        "required": ["decidedAt", "reasonCode", "missingRequirements"],
        "properties": {
          "metadata": {"properties": {"messageType": {"const": "BACKTEST_UNAVAILABLE"}}}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "CANCELLED"}}, "required": ["status"]},
      "then": {
        "required": ["cancelledAt", "attempt", "reasonCode"],
        "properties": {
          "metadata": {"properties": {"messageType": {"const": "BACKTEST_CANCELLED"}}}
        }
      }
    }
  ],
  "$defs": {
    "text": {"$ref": "https://contracts.idea2strategy.io/common/v1/primitives.schema.json#/$defs/nonEmptyString"},
    "sha256": {"$ref": "https://contracts.idea2strategy.io/common/v1/primitives.schema.json#/$defs/sha256Prefixed"},
    "uuid": {"$ref": "https://contracts.idea2strategy.io/common/v1/primitives.schema.json#/$defs/uuid"},
    "timestamp": {"$ref": "https://contracts.idea2strategy.io/common/v1/primitives.schema.json#/$defs/utcTimestamp"}
  }
}
